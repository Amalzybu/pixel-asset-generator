{
  "name": "pixel-asset-generator",
  "version": "0.6.0",
  "description": "A desktop tool for game developers to generate pixel-art assets and sprites",
  "main": "electron/main.js",
  "scripts": {
    "gui": "electron .",
    "gui:dev": "electron . --inspect",
    "cli": "node src/cli.js",
    "dist": "electron-builder --win --x64"
  },
  "keywords": [
    "pixel-art",
    "sprite",
    "game-dev",
    "procedural-generation",
    "tileset",
    "electron"
  ],
  "license": "MIT",
  "build": {
    "appId": "com.pixelgen.app",
    "productName": "Pixel Asset Generator",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "portable"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "generate_walk_v3.js",
      "generate_walk_v2.js",
      "generate_walk.js",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!dist/**/*"
    ],
    "extraResources": []
  },
  "dependencies": {
    "canvas": "^2.11.2",
    "gif-encoder-2": "^1.0.5",
    "pngjs": "^7.0.0",
    "sharp": "^0.33.0",
    "simplex-noise": "^4.0.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9"
  }
}
